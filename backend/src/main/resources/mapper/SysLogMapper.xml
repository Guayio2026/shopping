<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.scaffold.mapper.SysLogMapper">

    <resultMap id="SysLogResultMap" type="com.scaffold.entity.SysLog">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="username" column="username"/>
        <result property="type" column="type"/>
        <result property="module" column="module"/>
        <result property="action" column="action"/>
        <result property="ip" column="ip"/>
        <result property="detail" column="detail"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <select id="findPage" resultMap="SysLogResultMap">
        SELECT * FROM sys_log
        <where>
            <if test="keyword != null and keyword != ''">
                AND (username LIKE CONCAT('%', #{keyword}, '%')
                OR module LIKE CONCAT('%', #{keyword}, '%')
                OR action LIKE CONCAT('%', #{keyword}, '%'))
            </if>
            <if test="type != null and type != ''">AND type = #{type}</if>
        </where>
        ORDER BY id DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="countPage" resultType="long">
        SELECT COUNT(*) FROM sys_log
        <where>
            <if test="keyword != null and keyword != ''">
                AND (username LIKE CONCAT('%', #{keyword}, '%')
                OR module LIKE CONCAT('%', #{keyword}, '%')
                OR action LIKE CONCAT('%', #{keyword}, '%'))
            </if>
            <if test="type != null and type != ''">AND type = #{type}</if>
        </where>
    </select>

    <select id="countAll" resultType="long">
        SELECT COUNT(*) FROM sys_log
    </select>

    <!-- 【近 N 日日志量】接口 SysLogMapper.countDailyCreated（后台首页折线图）
         ⚠️ GROUP BY 用别名 name、ORDER BY 用 MIN(created_at)，
            否则 MySQL 5.7 的 ONLY_FULL_GROUP_BY 会报 1055（详见 UserMapper.xml 同款注释） -->
    <select id="countDailyCreated" resultType="com.scaffold.dto.NameCount">
        SELECT DATE_FORMAT(created_at, '%m-%d') AS name, COUNT(*) AS value
        FROM sys_log
        WHERE created_at &gt;= DATE_SUB(CURDATE(), INTERVAL #{days} - 1 DAY)
        GROUP BY name
        ORDER BY MIN(created_at) ASC
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sys_log (user_id, username, type, module, action, ip, detail)
        VALUES (#{userId}, #{username}, #{type}, #{module}, #{action}, #{ip}, #{detail})
    </insert>

    <delete id="deleteById">
        DELETE FROM sys_log WHERE id = #{id}
    </delete>

</mapper>

<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.scaffold.mapper.SysMenuMapper">

    <resultMap id="SysMenuResultMap" type="com.scaffold.entity.SysMenu">
        <id property="id" column="id"/>
        <result property="parentId" column="parent_id"/>
        <result property="title" column="title"/>
        <result property="path" column="path"/>
        <result property="icon" column="icon"/>
        <result property="sortOrder" column="sort_order"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <select id="findById" resultMap="SysMenuResultMap">
        SELECT * FROM sys_menu WHERE id = #{id}
    </select>

    <select id="findAll" resultMap="SysMenuResultMap">
        SELECT * FROM sys_menu ORDER BY sort_order ASC, id ASC
    </select>

    <select id="findPage" resultMap="SysMenuResultMap">
        SELECT * FROM sys_menu ORDER BY sort_order ASC, id DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="countPage" resultType="long">
        SELECT COUNT(*) FROM sys_menu
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sys_menu (parent_id, title, path, icon, sort_order, status)
        VALUES (#{parentId}, #{title}, #{path}, #{icon}, #{sortOrder}, #{status})
    </insert>

    <update id="update">
        UPDATE sys_menu
        <set>
            <if test="parentId != null">parent_id = #{parentId},</if>
            <if test="title != null">title = #{title},</if>
            <if test="path != null">path = #{path},</if>
            <if test="icon != null">icon = #{icon},</if>
            <if test="sortOrder != null">sort_order = #{sortOrder},</if>
            <if test="status != null">status = #{status},</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM sys_menu WHERE id = #{id}
    </delete>

</mapper>

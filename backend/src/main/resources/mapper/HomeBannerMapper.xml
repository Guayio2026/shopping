<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.scaffold.mapper.HomeBannerMapper">

    <resultMap id="BaseResultMap" type="com.scaffold.entity.HomeBanner">
        <id property="id" column="id"/>
        <result property="title" column="title"/>
        <result property="subtitle" column="subtitle"/>
        <result property="cover" column="cover"/>
        <result property="linkUrl" column="link_url"/>
        <result property="ctaText" column="cta_text"/>
        <result property="sortOrder" column="sort_order"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="findById" resultMap="BaseResultMap">
        SELECT * FROM home_banner WHERE id = #{id}
    </select>

    <select id="findAll" resultMap="BaseResultMap">
        SELECT * FROM home_banner
        <where>
            <if test="status != null">
                AND status = #{status}
            </if>
        </where>
        ORDER BY sort_order ASC, id ASC
    </select>

    <select id="findPage" resultMap="BaseResultMap">
        SELECT * FROM home_banner
        <where>
            <if test="keyword != null and keyword != ''">
                AND (title LIKE CONCAT('%', #{keyword}, '%')
                OR subtitle LIKE CONCAT('%', #{keyword}, '%'))
            </if>
        </where>
        ORDER BY sort_order ASC, id ASC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="countPage" resultType="long">
        SELECT COUNT(*) FROM home_banner
        <where>
            <if test="keyword != null and keyword != ''">
                AND (title LIKE CONCAT('%', #{keyword}, '%')
                OR subtitle LIKE CONCAT('%', #{keyword}, '%'))
            </if>
        </where>
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO home_banner (title, subtitle, cover, link_url, cta_text, sort_order, status)
        VALUES (#{title}, #{subtitle}, #{cover}, #{linkUrl}, #{ctaText}, #{sortOrder}, #{status})
    </insert>

    <update id="update">
        UPDATE home_banner
        <set>
            <if test="title != null">title = #{title},</if>
            <if test="subtitle != null">subtitle = #{subtitle},</if>
            <if test="cover != null">cover = #{cover},</if>
            <if test="linkUrl != null">link_url = #{linkUrl},</if>
            <if test="ctaText != null">cta_text = #{ctaText},</if>
            <if test="sortOrder != null">sort_order = #{sortOrder},</if>
            <if test="status != null">status = #{status},</if>
            updated_at = CURRENT_TIMESTAMP
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM home_banner WHERE id = #{id}
    </delete>
</mapper>

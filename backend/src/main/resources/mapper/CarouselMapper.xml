<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
  轮播图 SQL 映射文件（整条链路里唯一真正执行 SQL 的地方）

  ========================== 它是链路的最底层 ==========================
  前端按钮点击
    → Carousels.vue 的方法
      → api/carousel.js 的函数
        → CarouselController 的接口
          → CarouselService 的业务方法
            → CarouselMapper 接口声明
              → 【本文件执行 SQL】
                → MySQL 的 shopping.carousel 表
  数据查出来后，再一层层原路返回，最后渲染成页面上的表格行。
  ====================================================================

  ★★★ 【这里是 JOIN，和 Type2Mapper.xml 不一样】★★★

  carousel 表里只有 goods_id（商品 id），没有商品名字。
  但页面要显示「三只松鼠每日坚果礼盒」这种可读的文字，怎么办？

  → 用 JOIN 去 goods 表把名字"带"出来：

      SELECT c.id, c.name, c.cover, c.goods_id,
             gd.name  AS goods_name,
             gd.cover AS goods_cover
      FROM carousel c
      LEFT JOIN goods gd ON c.goods_id = gd.id

  四个要点：
    ① c / gd 是「表别名」，给表起短名，后面引用列时写 c.name 而不是 carousel.name
       ⚠️ 这里为什么用 gd 而不是 g？因为 g 在本项目其他 XML 里指的是「商品主表」。
          本文件的主表是 carousel（别名 c），商品表是「关联表」，所以另起个名字 gd（goods 缩写），
          免得看代码的人误会 —— 也给以后新增 JOIN 留出名字空间。
    ② 用 LEFT JOIN 而不是 JOIN —— 即使选中的商品被删了（goods_id 找不到），
       这张轮播图也要能显示出来（商品名那列显示为空），而不是整条记录消失
    ③ AS goods_name 是「列别名」，让结果里的列名叫 goods_name，好和 resultMap 对上
    ④ 用 LEFT JOIN 时，条件写在 ON 后面，不要写在 WHERE 里（写在 WHERE 会退化成 INNER JOIN）

  ★★★ 【和教程最大的区别】★★★
  教程的 Service 是这样拿商品名的（这叫 N+1 查询）：
      carouselPage.getRecords().stream().forEach(carousel -> {
          Goods goods = goodsMapper.selectById(carousel.getGoodsId());   ← 每条记录再查一次库
          carousel.setGoodsName(Objects.nonNull(goods) ? goods.getName() : "未知商品");
      });
  查 10 条轮播图 = 1 次分页查询 + 10 次商品查询 = 11 次数据库往返。
  本项目改用 JOIN：1 次 SQL 全部拿回来，数据库只被访问 1 次。
  （数据量小的时候两者都能用，但 JOIN 是更好的习惯。）

  【和 Java 接口的对应关系】
  namespace 必须是接口全名：com.scaffold.mapper.CarouselMapper
  下面每个 id 必须和接口方法名一模一样，写错启动就报错：
     接口 findPage()  ↔  <select id="findPage">
     接口 insert()    ↔  <insert id="insert">

  ⚠️⚠️ 【警告】本文件绝对不要用 Ctrl+R 批量替换！⚠️⚠️
  因为下面这些关键字都含 "type"，一替换就废：
    第 2 行  <!DOCTYPE ...>            ← 被改成 DOCarousel → XML 直接报错
    resultMap 的 type="..." 属性       ← 被改成 Carousel="..." → MyBatis 解析失败
    查询的 resultType="long" 属性      ← 被改成 resultCarousel="long" → 解析失败
  改本文件时，请手动逐处修改。
-->
<mapper namespace="com.scaffold.mapper.CarouselMapper">

    <!-- 结果映射：把数据库查出来的"列"翻译成 Java 对象的"字段"
         【为什么要翻译】数据库习惯下划线命名（goods_id），Java 习惯驼峰（goodsId）。
         有了这份映射，实体类就不用写任何注解，前端也不用管命名差异。 -->
    <resultMap id="BaseResultMap" type="com.scaffold.entity.Carousel">
        <id property="id" column="id"/>                      <!-- 主键 -->
        <result property="name" column="name"/>              <!-- 轮播图名称 -->
        <result property="cover" column="cover"/>            <!-- 封面图 -->
        <result property="goodsId" column="goods_id"/>       <!-- 下划线 → 驼峰，关联的商品 id -->

        <!-- ★ 下面两个不是 carousel 表的列，是 JOIN 出来的「虚拟列」
             gd.name  AS goods_name   →  装进 goodsName 字段  →  前端显示「三只松鼠每日坚果礼盒」
             gd.cover AS goods_cover  →  装进 goodsCover 字段 →  详情抽屉里显示商品图 -->
        <result property="goodsName" column="goods_name"/>
        <result property="goodsCover" column="goods_cover"/>
    </resultMap>

    <!-- 【可复用的 SQL 片段】查询字段清单
         把 JOIN 出来的两个虚拟列也一起 SELECT 出来。
         <include refid="baseColumns"/> 可以在多处复用，避免重复抄一大串。 -->
    <sql id="baseColumns">
        c.id, c.name, c.cover, c.goods_id,
        gd.name  AS goods_name,
        gd.cover AS goods_cover
    </sql>

    <!-- 【可复用的 SQL 片段】表 + JOIN
         LEFT JOIN 保证：商品不存在时，轮播图记录依然会返回（商品名那列显示为空） -->
    <sql id="baseFrom">
        FROM carousel c
        LEFT JOIN goods gd ON c.goods_id = gd.id
    </sql>

    <!-- 【可复用的 SQL 片段】筛选条件（只按名称搜）
         ⚠️ 注意：findPage 和 countPage 必须用同一套条件，
            否则会出现「总数说 10 条，但列表只显示 3 条」这种诡异情况 -->
    <sql id="baseWhere">
        <where>
            <if test="keyword != null and keyword != ''">
                AND c.name LIKE CONCAT('%', #{keyword}, '%')
            </if>
        </where>
    </sql>

    <!-- 【查一条】接口 CarouselMapper.findById
         链路：前端 getCarouselById() → Controller.getById → Service.getById → 这里 -->
    <select id="findById" resultMap="BaseResultMap">
        SELECT <include refid="baseColumns"/>
        <include refid="baseFrom"/>
        WHERE c.id = #{id}
    </select>

    <!-- 【查全部】接口 CarouselMapper.findAll
         链路：前端 getCarouselList() → Controller.list → Service.listAll → 这里
         按 id 降序：最新添加的排在最前面 -->
    <select id="findAll" resultMap="BaseResultMap">
        SELECT <include refid="baseColumns"/>
        <include refid="baseFrom"/>
        ORDER BY c.id DESC
    </select>

    <!-- 【分页数据】接口 CarouselMapper.findPage
         链路：前端 getCarouselPage()（打开页面/查询/翻页）→ Controller.page → Service.page → 这里
         LIMIT #{limit} OFFSET #{offset}：每页取 limit 条，跳过 offset 条
         （offset 是 Service 算好的：(page-1)*size） -->
    <select id="findPage" resultMap="BaseResultMap">
        SELECT <include refid="baseColumns"/>
        <include refid="baseFrom"/>
        <include refid="baseWhere"/>
        ORDER BY c.id DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <!-- 【分页总数】接口 CarouselMapper.countPage
         链路：和 findPage 一起被 Service.page 调用
         作用：前端分页控件要显示「共 N 条」、要算总页数
         ⚠️ 条件必须和上面的 findPage 一致（所以共用 baseWhere 片段）
         💡 这里共用 baseFrom 也不会算错：goods_id → goods.id 是多对一（goods.id 是主键），
            LEFT JOIN 不可能把一行 carousel 变成两行，所以 COUNT(*) 就是轮播图条数。 -->
    <select id="countPage" resultType="long">
        SELECT COUNT(*)
        <include refid="baseFrom"/>
        <include refid="baseWhere"/>
    </select>

    <!-- 【新增】接口 CarouselMapper.insert
         链路：前端弹窗点「确定」（新增）→ Controller.create → Service.create → 这里
         useGeneratedKeys="true" keyProperty="id"：
           插入时数据库会自动生成自增 id，这两个属性让 MyBatis 把新 id 回填到 Java 对象的 id 上，
           Service 才能立刻拿 carousel.getId() 去回查刚插入的那条记录。
         ⚠️ goodsName / goodsCover 不在列里 —— 它们不是表字段，是 JOIN 出来的虚拟列 -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO carousel (name, cover, goods_id)
        VALUES (#{name}, #{cover}, #{goodsId})
    </insert>

    <!-- 【修改】接口 CarouselMapper.update
         链路：前端弹窗点「确定」（编辑）→ Controller.update → Service.update → 这里
         <set> + <if> 是动态 SQL：只更新「传了值」的字段。
           某个字段为空 → 不动那一列（不会把原来的内容清空）
         ⚠️ 教程用的是 carouselMapper.updateById(carousel)，那是 MyBatis-Plus 的「全字段更新」，
            它会把没传的字段一起写成 NULL。本项目的 <set>+<if> 只改传了的字段，更安全。 -->
    <update id="update">
        UPDATE carousel
        <set>
            <if test="name != null">name = #{name},</if>
            <if test="cover != null">cover = #{cover},</if>
            <if test="goodsId != null">goods_id = #{goodsId},</if>
        </set>
        WHERE id = #{id}
    </update>

    <!-- 【删除】接口 CarouselMapper.deleteById
         链路：前端表格点「删除」→ Controller.delete → Service.delete → 这里
         返回的「影响行数」是 1 表示删掉了 1 条；Service 已提前用 getById 校验过存在性 -->
    <delete id="deleteById">
        DELETE FROM carousel WHERE id = #{id}
    </delete>
</mapper>

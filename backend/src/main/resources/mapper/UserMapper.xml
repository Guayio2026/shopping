<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.scaffold.mapper.UserMapper">

    <resultMap id="UserResultMap" type="com.scaffold.entity.User">
        <id property="id" column="id"/>
        <result property="username" column="username"/>
        <result property="password" column="password"/>
        <result property="nickname" column="nickname"/>
        <result property="avatar" column="avatar"/>
        <result property="phone" column="phone"/>
        <result property="role" column="role"/>
        <result property="status" column="status"/>
        <result property="openid" column="openid"/>
        <result property="balance" column="balance"/>
        <result property="account" column="account"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <sql id="BaseColumns">
        id, username, password, nickname, avatar, phone, role, status, openid, balance, account, created_at, updated_at
    </sql>

    <select id="findById" resultMap="UserResultMap">
        SELECT <include refid="BaseColumns"/> FROM `user` WHERE id = #{id}
    </select>

    <select id="findByUsername" resultMap="UserResultMap">
        SELECT <include refid="BaseColumns"/> FROM `user` WHERE username = #{username} LIMIT 1
    </select>

    <select id="findByOpenid" resultMap="UserResultMap">
        SELECT <include refid="BaseColumns"/> FROM `user` WHERE openid = #{openid} LIMIT 1
    </select>

    <select id="findPage" resultMap="UserResultMap">
        SELECT <include refid="BaseColumns"/> FROM `user`
        <where>
            <if test="keyword != null and keyword != ''">
                AND (username LIKE CONCAT('%', #{keyword}, '%')
                OR nickname LIKE CONCAT('%', #{keyword}, '%')
                OR phone LIKE CONCAT('%', #{keyword}, '%'))
            </if>
            <if test="role != null and role != ''">
                AND role = #{role}
            </if>
        </where>
        ORDER BY id DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="countPage" resultType="long">
        SELECT COUNT(*) FROM `user`
        <where>
            <if test="keyword != null and keyword != ''">
                AND (username LIKE CONCAT('%', #{keyword}, '%')
                OR nickname LIKE CONCAT('%', #{keyword}, '%')
                OR phone LIKE CONCAT('%', #{keyword}, '%'))
            </if>
            <if test="role != null and role != ''">
                AND role = #{role}
            </if>
        </where>
    </select>

    <!--
      insert 故意不写 account 列：建表时给了 DEFAULT 0，新用户不写就是 0，
      这正是「默认值 0」的用武之地——少写一个字段，少一处出错可能。
      注册时如果想显式给初始余额，在这里补一列即可。
    -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO `user` (username, password, nickname, avatar, phone, role, status, openid, balance)
        VALUES (#{username}, #{password}, #{nickname}, #{avatar}, #{phone}, #{role}, #{status}, #{openid}, #{balance})
    </insert>

    <update id="update">
        UPDATE `user`
        <set>
            <if test="nickname != null">nickname = #{nickname},</if>
            <if test="avatar != null">avatar = #{avatar},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="role != null">role = #{role},</if>
            <if test="status != null">status = #{status},</if>
            <if test="openid != null">openid = #{openid},</if>
            <if test="balance != null">balance = #{balance},</if>
            updated_at = CURRENT_TIMESTAMP
        </set>
        WHERE id = #{id}
    </update>

    <update id="updatePassword">
        UPDATE `user` SET password = #{password}, updated_at = CURRENT_TIMESTAMP WHERE id = #{id}
    </update>

    <update id="updateBalance">
        UPDATE `user` SET balance = #{balance}, updated_at = CURRENT_TIMESTAMP WHERE id = #{id}
    </update>

    <update id="deductBalance">
        UPDATE `user`
        SET balance = balance - #{amount}, updated_at = CURRENT_TIMESTAMP
        WHERE id = #{id} AND balance >= #{amount}
    </update>

    <update id="addBalance">
        UPDATE `user`
        SET balance = balance + #{amount}, updated_at = CURRENT_TIMESTAMP
        WHERE id = #{id}
    </update>

    <!-- ===== 以下两条是「账户余额 account」专用（充值 / 支付链路）=====
         写法和上面 balance 两条完全一样，只是钱袋子换了名字。
         核心思想：钱的增减必须走【原子 SQL】，不能「先查出来、在内存里加减、再整行写回」——
         后者在两人同时充值时，后写回的会把先写回的覆盖掉（丢失更新）。 -->

    <!-- 充值：余额 = 余额 + 金额。不用 AND 条件——加钱没有「加不进去」的可能 -->
    <update id="addAccount">
        UPDATE `user`
        SET account = account + #{amount}, updated_at = CURRENT_TIMESTAMP
        WHERE id = #{id}
    </update>

    <!-- 扣款：余额 = 余额 - 金额，但加了 AND account >= #{amount} 条件。
         余额不够时 MySQL 直接不更新、返回 0 行，Service 靠返回值判断「余额不足」，
         不用先查一次余额——少一次查询，也没有「查完到扣之间被人花掉」的时间差 -->
    <update id="deductAccount">
        UPDATE `user`
        SET account = account - #{amount}, updated_at = CURRENT_TIMESTAMP
        WHERE id = #{id} AND account >= #{amount}
    </update>

    <delete id="deleteById">
        DELETE FROM `user` WHERE id = #{id}
    </delete>

    <select id="countAll" resultType="long">
        SELECT COUNT(*) FROM `user`
    </select>

    <!-- 【近 N 日新增用户】接口 UserMapper.countDailyCreated（后台首页柱状图）
         ⚠️ GROUP BY 必须用「别名 name」，不能写 GROUP BY DATE(created_at)：
            SELECT 里选的是 DATE_FORMAT(created_at,'%m-%d')，GROUP BY 里是 DATE(created_at)，
            两者不是一个表达式，MySQL 5.7 默认开启 ONLY_FULL_GROUP_BY 会直接报
            1055: Expression #1 of SELECT list is not in GROUP BY clause
         ⚠️ ORDER BY 同理，不能写 DATE(created_at)，改用聚合 MIN(created_at) -->
    <select id="countDailyCreated" resultType="com.scaffold.dto.NameCount">
        SELECT DATE_FORMAT(created_at, '%m-%d') AS name, COUNT(*) AS value
        FROM `user`
        WHERE created_at &gt;= DATE_SUB(CURDATE(), INTERVAL #{days} - 1 DAY)
        GROUP BY name
        ORDER BY MIN(created_at) ASC
    </select>

</mapper>
